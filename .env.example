# Research provider, also used by translation unless overridden below.
# Install and authenticate the matching CLI for real model output.
GLYPH_AI_MODE=claude_cli
# GLYPH_AI_MODE=codex_cli
# GLYPH_AI_MODE=mock  # deterministic development output only

# Optional provider model override.
# GLYPH_CLI_MODEL=

# Translation only may use your own OrcaRouter account instead of the CLI above.
# Summaries, Research Maps and Implementation Contracts keep using GLYPH_AI_MODE.
# Choose a text model with JSON object output support; keys stay local and are
# never returned to the browser. Settings entered in the UI are session-only.
# GLYPH_TRANSLATION_PROVIDER=orcarouter
# ORCAROUTER_API_KEY=
# GLYPH_ORCAROUTER_MODEL=

# Conservative defaults for long documents.
GLYPH_CLI_BATCH_SIZE=24
GLYPH_CLI_CONCURRENCY=3
GLYPH_CLI_TIMEOUT_SECONDS=300
GLYPH_FRONTEND_PORT=5173
GLYPH_BACKEND_PORT=8000

# Maximum accepted upload size in bytes (default: 50 MiB).
GLYPH_MAX_UPLOAD_BYTES=52428800

# Text-backed PDFs work in mock mode through Poppler text extraction.
# Use unlimited_ocr for scanned PDFs and images after configuring the upstream repo.
GLYPH_OCR_MODE=mock
GLYPH_OCR_TIMEOUT_SECONDS=300
GLYPH_PAGE_RENDER_TIMEOUT_SECONDS=30
GLYPH_RESEARCH_JOB_MAX_ATTEMPTS=2
# Reader blocks sent per schema-constrained Research Map extraction request.
GLYPH_RESEARCH_CLI_BLOCK_BATCH_SIZE=12
# Reader blocks sent per schema-constrained Implementation Contract extraction request.
GLYPH_CONTRACT_CLI_BLOCK_BATCH_SIZE=8
# GLYPH_UNLIMITED_OCR_REPO=/absolute/path/to/Unlimited-OCR
# GLYPH_UNLIMITED_OCR_COMMAND=python /path/to/wrapper.py --input {input} --output_dir {output_dir}

# Defaults already point to repository-local book/ and data/ directories.
# GLYPH_BOOK_DIR=
# GLYPH_DATA_DIR=
# GLYPH_DATABASE_URL=

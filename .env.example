# Translation provider. Install and authenticate the matching CLI first.
GLYPH_AI_MODE=claude_cli
# GLYPH_AI_MODE=codex_cli

# Optional provider model override.
# GLYPH_CLI_MODEL=

# Conservative defaults for long documents.
GLYPH_CLI_BATCH_SIZE=24
GLYPH_CLI_CONCURRENCY=3
GLYPH_CLI_TIMEOUT_SECONDS=300
GLYPH_FRONTEND_PORT=5173

# Maximum accepted upload size in bytes (default: 50 MiB).
GLYPH_MAX_UPLOAD_BYTES=52428800

# Text-backed PDFs work in mock mode through Poppler text extraction.
# Use unlimited_ocr for scanned PDFs and images after configuring the upstream repo.
GLYPH_OCR_MODE=mock
# GLYPH_UNLIMITED_OCR_REPO=/absolute/path/to/Unlimited-OCR
# GLYPH_UNLIMITED_OCR_COMMAND=python /path/to/wrapper.py --input {input} --output_dir {output_dir}

# Defaults already point to repository-local book/ and data/ directories.
# GLYPH_BOOK_DIR=
# GLYPH_DATA_DIR=
# GLYPH_DATABASE_URL=
